# Paste real connection strings from your Neon dashboard.
# The pooled URL is used for the running NestJS application.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require"
# The direct URL is used for Prisma Migrate/CLI only.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/neondb?sslmode=require"
# Keep this key outside the database and secret management protected.
QR_ENCRYPTION_KEY="REPLACE_WITH_SECURE_SECRET_FROM_SECRET_MANAGER"

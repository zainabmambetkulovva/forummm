    "web-push": "^3.6.6",
    "shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/web-push": "^3.6.3",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.3"

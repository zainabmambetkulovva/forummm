# ==========================================
# DATABASE (Neon Serverless PostgreSQL)
# ==========================================
# Pooled connection for runtime
DATABASE_URL="postgresql://user:password@hostname.neon.tech/forum_kg?sslmode=require&connection_limit=10&pool_timeout=0"

# Direct connection for migrations
DIRECT_URL="postgresql://user:password@hostname.neon.tech/forum_kg?sslmode=require"

# ==========================================
# API CONFIGURATION
# ==========================================
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# REDIS & BULLMQ
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# SMS PROVIDER (To be selected)
# ==========================================
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=

# ==========================================
# FINIK PAYMENT
# ==========================================
FINIK_API_KEY=your-finik-api-key
FINIK_SECRET_KEY=your-finik-secret-key
FINIK_WEBHOOK_SECRET=your-finik-webhook-secret
FINIK_API_URL=https://api.finik.kg

# ==========================================
# TELEGRAM BOT
# ==========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# ==========================================
# FILE STORAGE (S3 Compatible)
# ==========================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forum-kg-uploads
S3_REGION=us-east-1

# ==========================================
# MONITORING & LOGGING
# ==========================================
SENTRY_DSN=
LOG_LEVEL=debug

# ==========================================
# ENCRYPTION
# ==========================================
# QR Token encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-for-qr-tokens

# ==========================================
# TIMEZONE & LOCALE
# ==========================================
TZ=Asia/Bishkek
DEFAULT_LOCALE=ru
